+/// One way an agent lets the person sign in (`authMethods` of `initialize`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AuthMethod {
+    pub id: String,
+    pub name: String,
+    pub description: Option<String>,
+    /// A method the person carries out in a terminal on the agent's machine (`type: terminal`): the
+    /// arguments the agent says to run it with. `None` for one the agent handles itself
+    /// (`authenticate` answers it).
+    pub terminal_args: Option<Vec<String>>,
+}
+
+/// What the agent said it can do in `initialize` (`agentCapabilities`, `agentInfo`, `authMethods`).
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct AgentCaps {
+    pub name: Option<String>,
+    pub title: Option<String>,
+    pub version: Option<String>,
+    /// `promptCapabilities.image`: a prompt may carry pictures.
+    pub images: bool,
+    /// `promptCapabilities.audio`.
+    pub audio: bool,
+    /// `promptCapabilities.embeddedContext`: a prompt may embed a file's text.
+    pub embedded_context: bool,
+    /// `loadSession`.
+    pub load_session: bool,
+    /// `sessionCapabilities.resume`.
+    pub resume: bool,
+    /// `sessionCapabilities.list`.
+    pub list: bool,
+    /// `sessionCapabilities.close`.
+    pub close: bool,
+    /// `auth.logout`.
+    pub logout: bool,
+    pub auth_methods: Vec<AuthMethod>,
+}
+
+impl AgentCaps {
+    /// Reads the keeper's answer to `initialize`, which is the agent's own with `loadSession` set.
+    fn from_init(init: &Value) -> AgentCaps {
+        let flag = |p: &str| init.pointer(p).and_then(Value::as_bool).unwrap_or(false);
+        // `{}` is how a capability that takes no settings is switched on.
+        let has = |p: &str| init.pointer(p).is_some_and(|v| !v.is_null() && v != &json!(false));
+        let text = |p: &str| {
+            init.pointer(p)
+                .and_then(Value::as_str)
+                .map(str::to_string)
+                .filter(|s| !s.is_empty())
