+/// The text a tool's `rawOutput` holds, for the shapes agents use: a string, or an object with the
+/// output under one of a few names (`stdout` and `stderr` are joined).
+fn raw_output_text(v: &Value) -> Option<String> {
+    let text = match v {
+        Value::String(s) => s.clone(),
+        Value::Object(o) => {
+            let field = |k: &str| o.get(k).and_then(Value::as_str).filter(|s| !s.is_empty());
+            if let Some(s) = ["output", "aggregated_output", "formatted_output", "text"]
+                .iter()
+                .find_map(|k| field(k))
+            {
+                s.to_string()
+            } else {
+                match (field("stdout"), field("stderr")) {
+                    (Some(a), Some(b)) => format!("{a}\n{b}"),
+                    (Some(s), None) | (None, Some(s)) => s.to_string(),
+                    (None, None) => return None,
+                }
+            }
+        }
+        _ => return None,
+    };
+    (!text.is_empty()).then_some(text)
+}
