+/// One line of an agent's text: control characters out, white space folded.
+fn clean_line(s: &str) -> String {
+    s.chars()
+        .map(|c| if c.is_whitespace() { ' ' } else { c })
+        .filter(|c| !is_unsafe_control(*c))
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+/// Text of an agent's, control characters out; newlines and tabs stay.
+fn clean_text(s: &str) -> String {
+    s.chars()
+        .filter(|c| !is_unsafe_control(*c))
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+/// The last word of a path or address, for what a person reads.
+fn base_name(uri: &str) -> &str {
+    uri.trim_end_matches('/').rsplit('/').next().unwrap_or(uri)
+}
+
+/// Bytes a base64 text of this length decodes to (an estimate good to two bytes).
+fn decoded_len(base64: &str) -> u64 {
+    let pad = base64.bytes().rev().take_while(|b| *b == b'=').count();
+    (base64.len() as u64 / 4 * 3).saturating_sub(pad as u64)
+}
+
+/// An `image`, `audio`, `resource_link` or `resource` block; `None` for any other type.
+fn part_of(c: &Value) -> Option<Part> {
+    let named = |name: Option<&str>, uri: Option<&str>, fallback: &str| -> String {
+        name.map(clean_line)
+            .filter(|n| !n.is_empty())
+            .or_else(|| uri.map(|u| clean_line(base_name(u))).filter(|n| !n.is_empty()))
+            .unwrap_or_else(|| fallback.to_string())
+    };
+    match str_of(c, "type")? {
+        "image" => {
+            let data = str_of(c, "data");
+            Some(Part {
+                kind: PartKind::Image,
+                name: named(None, str_of(c, "uri"), "image"),
+                uri: str_of(c, "uri").map(str::to_string),
+                mime: str_of(c, "mimeType").map(str::to_string),
+                size: data.map(decoded_len),
+                data: data
+                    .filter(|d| d.len() <= PART_DATA_MAX)
+                    .map(str::to_string),
+            })
+        }
+        "audio" => Some(Part {
+            kind: PartKind::Audio,
+            name: "audio".to_string(),
+            uri: None,
+            mime: str_of(c, "mimeType").map(str::to_string),
+            size: str_of(c, "data").map(decoded_len),
+            data: None,
+        }),
+        "resource_link" => {
+            let uri = str_of(c, "uri");
+            if str_of(c, "name").is_none() && uri.is_none() {
+                return None;
+            }
+            Some(Part {
+                kind: PartKind::Link,
+                name: named(str_of(c, "name"), uri, "file"),
+                uri: uri.map(str::to_string),
+                mime: str_of(c, "mimeType").map(str::to_string),
+                size: c.get("size").and_then(Value::as_u64),
+                data: None,
+            })
+        }
+        "resource" => {
+            let r = c.get("resource")?;
+            let uri = str_of(r, "uri");
+            Some(Part {
+                kind: PartKind::Resource,
+                name: named(None, uri, "resource"),
+                uri: uri.map(str::to_string),
+                mime: str_of(r, "mimeType").map(str::to_string),
+                size: str_of(r, "text")
