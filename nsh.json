{
  "name": "Herdr Desktop",
  "id": "dev.herdrmobile.herdr_desktop",
  "version": "0.1.0-alpha.13",
  "build": 1,
  "icon": "icon.png",
  "appearance": "system",
  "theme": "theme.json",
  "rust": ["native/app"],
  "tailwind": {
    "fontSize": {
      "xs": [12, 1.4],
      "sm": [13, 1.4],
      "base": [14, 1.55],
      "lg": [16, 1.4],
      "xl": [18, 1.35],
      "2xl": [22, 1.3],
      "3xl": [26, 1.25]
    },
    "radius": {
      "sm": 4,
      "base": 6,
      "md": 8,
      "lg": 12,
      "xl": 16,
      "2xl": 24
    },
    "shadow": {
      "sm": "0 0 0 1px rgb(0 0 0 / 0.10), 0 1px 3px rgb(0 0 0 / 0.06)",
      "md": "0 0 0 1px rgb(0 0 0 / 0.10), 0 4px 20px rgb(0 0 0 / 0.08)",
      "lg": "0 0 0 1px rgb(0 0 0 / 0.10), 0 8px 32px rgb(0 0 0 / 0.14)"
    }
  },
  "capabilities": {
    "clipboard": true,
    "openUrl": {
      "schemes": ["https", "http", "mailto"]
    },
    "network": {
      "http": [
        {
          "host": "api.github.com",
          "methods": ["GET"],
          "schemes": ["https"],
          "paths": ["/repos/tuan3w/herdr-desktop/releases"]
        }
      ]
    },
    "webview": {
      "hosts": ["*"]
    }
  }
}
