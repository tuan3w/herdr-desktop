{
  "name": "Herdr Desktop",
  "id": "dev.herdrmobile.herdr_desktop",
  "version": "0.1.0-alpha.2",
  "build": 1,
  "icon": "icon.png",
  "appearance": "system",
  "theme": "theme.json",
  "rust": ["native/app"],
  "tailwind": {
    "fontSize": {
      "xs": [13, 1.35],
      "sm": [15, 1.4],
      "base": [17, 1.4],
      "lg": [20, 1.35],
      "xl": [22, 1.3],
      "2xl": [26, 1.25],
      "3xl": [32, 1.2]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "xl": 16,
      "2xl": 24
    },
    "shadow": {
      "sm": "0 0 0 1px rgb(0 0 0 / 0.04), 0 1px 2px rgb(0 0 0 / 0.05), 0 2px 6px -2px rgb(0 0 0 / 0.06)",
      "md": "0 0 0 1px rgb(0 0 0 / 0.05), 0 2px 4px rgb(0 0 0 / 0.06), 0 8px 20px -6px rgb(0 0 0 / 0.14)",
      "lg": "0 0 0 1px rgb(0 0 0 / 0.06), 0 4px 8px rgb(0 0 0 / 0.07), 0 24px 48px -12px rgb(0 0 0 / 0.28)"
    }
  },
  "capabilities": {
    "clipboard": true,
    "openUrl": {
      "schemes": ["https", "http", "mailto"]
    },
    "network": {
      "http": [
        {
          "host": "api.github.com",
          "methods": ["GET"],
          "schemes": ["https"],
          "paths": ["/repos/tuan3w/herdr-desktop/releases/latest"]
        }
      ]
    },
    "webview": {
      "hosts": ["127.0.0.1"]
    }
  }
}
