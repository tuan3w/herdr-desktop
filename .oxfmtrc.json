{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["#"],
    "groups": [
      "side_effect",
      ["builtin", "external"],
      "type-external",
      ["internal", "subpath"],
      "type-internal",
      ["parent", "sibling", "index"],
      ["type-parent", "type-sibling", "type-index"],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "target",
    ".nsh",
    ".scratch",
    "native",
    "vendor",
    "fixtures",
    "fonts",
    "assets",
    "docs",
    "theme.json",
    "*.md"
  ]
}
